# EditorConfig — https://editorconfig.org
# Top-level config; all editor plugins must stop traversing here.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Python — ruff is the source of truth for formatting and import order
[*.py]
indent_size = 4
ij_formatter_enabled = false

# Data and config formats
[*.{json,yml,yaml}]
indent_size = 2
ij_formatter_enabled = false

[*.toml]
indent_size = 4

# Markdown — preserve trailing whitespace for hard line breaks
[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off
ij_formatter_enabled = false

# Makefiles require tabs
[Makefile]
indent_style = tab

# Dockerfiles
[{Dockerfile,Dockerfile.*}]
indent_size = 2

# Base-time tables are byte-exact reference data — an editor must not touch them.
[tests/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = false
max_line_length = off
ij_formatter_enabled = false
